{
    "name": "music",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "type": "module",
    "scripts": {
        "clean": "node scripts/clean.mjs",
        "typecheck": "tsx scripts/run-affected.ts typecheck",
        "typecheck:scripts": "tsc --project tsconfig.json",
        "lint": "tsx scripts/run-oxlint.ts --type-aware",
        "test": "tsx scripts/run-affected.ts test",
        "test:scripts": "node --import tsx --test scripts/*.test.ts",
        "check:ci:static": "pnpm lint && turbo run typecheck typecheck:scripts",
        "check:ci:unit": "turbo run test test:scripts",
        "check:build": "node --import tsx scripts/check-build.ts",
        "check:ci:e2e-desktop": "turbo run test:e2e:desktop",
        "check:ci:build": "pnpm --filter @music/player exec tauri build && pnpm check:build"
    },
    "devDependencies": {
        "@music/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "lefthook": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "tsx": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.15.0"
}
